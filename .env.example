# Copia este archivo como .env y completa los valores. NUNCA subas el .env al repositorio.

# --- Base de datos ---
# Sin DATABASE_URL: Docker usa el PostgreSQL local del servicio "db"
# y la ejecución sin Docker usa postgresql://apf3:apf3@localhost:5433/gestion_academica.
# Para Supabase (botón Connect > Connection String > URI > Session pooler). Pídela por privado al equipo:
# DATABASE_URL=postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

POSTGRES_USER=apf3
POSTGRES_PASSWORD=apf3
POSTGRES_DB=gestion_academica
POSTGRES_PORT=5433

# --- Autenticación ---
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esta-clave
JWT_EXPIRE_MINUTES=480

# --- API ---
BACKEND_PORT=8000
# Orígenes de Angular permitidos (separados por comas)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Carga 20 estudiantes sintéticos de demostración al iniciar (solo si la BD está vacía)
SEED_DEMO_DATA=true

# --- Machine Learning ---
# Vacío = autodetecta predict_risk / predict_final_grade / generate_groups dentro de Backend/ml/
ML_MODULE=
ML_MODEL_VERSION=demo-v1
